{"nodes": [{"id": "trash_hunter_gdd", "label": "Trash Hunter GDD v2.0", "file_type": "document", "source_file": "TRASH_HUNTER_GDD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "trash_hunter_gdd_the_reveal", "label": "The Reveal (core pillar)", "file_type": "rationale", "source_file": "TRASH_HUNTER_GDD.md", "source_location": "L81", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every dumpster should feel like opening a gift; the 50th must be as fun as the first. Moved to Phase 1 so the core moment is proven before building the map."}, {"id": "trash_hunter_gdd_police_pressure_differentiator", "label": "Police pressure and escape as market differentiator", "file_type": "rationale", "source_file": "TRASH_HUNTER_GDD.md", "source_location": "L73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Search-sell-upgrade loops alone are not unique (DUMP, Prospecting!, Dumpster Divers!); no direct competitor uses police pressure."}, {"id": "trash_hunter_gdd_competitor_dump", "label": "DUMP (competitor)", "file_type": "concept", "source_file": "TRASH_HUNTER_GDD.md", "source_location": "L64", "source_url": "https://www.rolimons.com/game/98868317791094", "captured_at": null, "author": null, "contributor": null}, {"id": "trash_hunter_gdd_competitor_prospecting", "label": "Prospecting! (competitor)", "file_type": "concept", "source_file": "TRASH_HUNTER_GDD.md", "source_location": "L66", "source_url": "https://www.rolimons.com/game/129827112113663", "captured_at": null, "author": null, "contributor": null}, {"id": "trash_hunter_gdd_competitor_dumpster_divers", "label": "Dumpster Divers! (competitor)", "file_type": "concept", "source_file": "TRASH_HUNTER_GDD.md", "source_location": "L68", "source_url": "https://www.roblox.com/games/133904667472313/Dumpster-Divers", "captured_at": null, "author": null, "contributor": null}, {"id": "trash_hunter_gdd_competitor_junk_mechanics", "label": "Junk Mechanics (competitor)", "file_type": "concept", "source_file": "TRASH_HUNTER_GDD.md", "source_location": "L770", "source_url": "https://www.rolimons.com/game/70435795041539", "captured_at": null, "author": null, "contributor": null}, {"id": "trash_hunter_gdd_ftue", "label": "First five minutes (FTUE, guaranteed tutorial Rare)", "file_type": "concept", "source_file": "TRASH_HUNTER_GDD.md", "source_location": "L104", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First play bounce rate is the most important Roblox RFY signal and is driven by the first five minutes."}, {"id": "trash_hunter_gdd_perfect_dig", "label": "Perfect Dig (dig layer timing)", "file_type": "concept", "source_file": "TRASH_HUNTER_GDD.md", "source_location": "L132", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Light skill element without a heavy minigame; tap-to-start instead of hold because holding plus tapping DIG needs two thumbs on mobile."}, {"id": "trash_hunter_gdd_dig_deeper", "label": "Dig deeper (push-your-luck)", "file_type": "concept", "source_file": "TRASH_HUNTER_GDD.md", "source_location": "L162", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dig deeper discards the current find; without that swap it would always be the best choice and there would be no decision."}, {"id": "trash_hunter_gdd_per_player_loot_cooldown", "label": "Per-player dumpster loot and cooldown", "file_type": "concept", "source_file": "TRASH_HUNTER_GDD.md", "source_location": "L175", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New players never find empty dumpsters; all rolls are server-side."}, {"id": "trash_hunter_gdd_rarity_tiers", "label": "Rarity tiers (Common to Jackpot)", "file_type": "concept", "source_file": "TRASH_HUNTER_GDD.md", "source_location": "L191", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "trash_hunter_gdd_mutations", "label": "Mutations (Shiny x2, Golden x5)", "file_type": "concept", "source_file": "TRASH_HUNTER_GDD.md", "source_location": "L213", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "trash_hunter_gdd_collection_book", "label": "Collection book", "file_type": "concept", "source_file": "TRASH_HUNTER_GDD.md", "source_location": "L224", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "trash_hunter_gdd_sell_or_display", "label": "Sell or display (Hideout shelves)", "file_type": "concept", "source_file": "TRASH_HUNTER_GDD.md", "source_location": "L233", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "trash_hunter_gdd_red_zone", "label": "Red zones", "file_type": "concept", "source_file": "TRASH_HUNTER_GDD.md", "source_location": "L246", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Danger must always be visible and consciously chosen; green zones never trigger a chase."}, {"id": "trash_hunter_gdd_suspicion_bar", "label": "Suspicion bar", "file_type": "concept", "source_file": "TRASH_HUNTER_GDD.md", "source_location": "L258", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "trash_hunter_gdd_police_state_machine", "label": "Police AI state machine (Patrol/Investigate/Chase/Catch/Return)", "file_type": "concept", "source_file": "TRASH_HUNTER_GDD.md", "source_location": "L271", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "trash_hunter_gdd_vision_cone_fallback", "label": "Vision cone / spotlight police fallback (3-day timebox)", "file_type": "rationale", "source_file": "TRASH_HUNTER_GDD.md", "source_location": "L311", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Roblox NPC pathfinding o